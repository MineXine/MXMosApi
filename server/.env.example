# 服务端环境变量
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# 数据库驱动：mongo（生产，使用真实 MongoDB） | memory（本地零依赖 / CI，不持久化）
DB_DRIVER=memory
MONGO_URI=mongodb+srv://3227988255_db_user:TcocB8IDFgV4Xr3e@cluster0.npq58cz.mongodb.net/

# JWT 签名密钥（生产务必替换为随机长字符串）
JWT_SECRET=shuoshuo-dev-secret-change-me
JWT_EXPIRES_IN=30d

# 上传目录与限制
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=20971520

# 分享链接的公开前缀（留空则前端自行拼接当前域名）
PUBLIC_BASE_URL=

# 跨域来源，* 或逗号分隔
CORS_ORIGIN=*
LOG_REQUESTS=true
